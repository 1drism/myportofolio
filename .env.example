# Copy to .env for local development. Never commit real values.

# Set to True on PWS (switches to PostgreSQL, turns DEBUG off, secure cookies, restricts CORS)
PRODUCTION=False

# Required when PRODUCTION=True. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Production only: comma-separated origins allowed to call the API from a browser
# CORS_ALLOWED_ORIGINS=https://your-web-app.example

# Production database (PostgreSQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
SCHEMA=public
